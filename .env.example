APP_NAME=ilbbec
APP_ENV=production
APP_KEY=base64:YmGdDYfBWa3/qxLG+bul/hElx/uIfkTb3C9oWh/Cwao=
APP_DEBUG=true
APP_URL=https://nama-project-anda.vercel.app

# Konfigurasi Log khusus Serverless Vercel (Wajib stderr agar tidak menulis file ke disk)
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Storage & Temporary Paths untuk Serverless Vercel
LARAVEL_STORAGE_PATH=/tmp/storage
VIEW_COMPILED_PATH=/tmp/storage/framework/views

# Cache & Session (Jangan gunakan "file" karena disk Vercel Read-Only)
CACHE_STORE=array
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync

# Database Online (Isi sesuai provider database Anda: Supabase, TiDB, Aiven, Railway, dll)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ilbbec
DB_USERNAME=root
DB_PASSWORD=

# Jika penyedia database online membutuhkan SSL (opsional, tergantung provider)
# MYSQL_ATTR_SSL_CA=
